{
    "name": "strautomator-web",
    "version": "26.453.12223",
    "description": "Strautomator.com website.",
    "author": "Igor Ramadas",
    "license": "AGPL-3.0-only",
    "repository": {
        "type": "git",
        "url": "https://github.com/ramadasnet/strautomator.git",
        "directory": "web"
    },
    "engines": {
        "node": "^22.22.0 || ^24.11.0 || >=26.0.0"
    },
    "scripts": {
        "dev": "cross-env STRAUTOMATOR_CRON=true nuxt dev --port 3000",
        "build": "nuxt build && node check-bundle.mjs",
        "start": "cross-env NODE_ENV=production node start.mjs",
        "preview": "nuxt preview",
        "typecheck": "nuxt prepare && tsc --noEmit -p .nuxt/tsconfig.server.json",
        "test": "tsx server/mcp/oauth.spec.ts && tsx server/mcp/utils.spec.ts",
        "postinstall": "nuxt prepare"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "@paddle/paddle-node-sdk": "^3.10.0",
        "@pinia/nuxt": "^1.0.3",
        "axios": "^1.21.0",
        "chart.js": "^4.6.1",
        "chartjs-adapter-dayjs-4": "^1.0.4",
        "chroma-js": "^3.2.0",
        "country-linkify": "^26.411.11020",
        "cross-env": "^10.1.0",
        "dayjs": "^1.11.23",
        "json-editor-vue": "^0.19.2",
        "lodash": "^4.18.1",
        "nuxt": "npm:nuxt-nightly@5.0.0-2611041151-9fcdd04",
        "pinia": "^4.1.0",
        "setmeup": "^2.0.0",
        "strautomator-core": "file:../core",
        "vanilla-jsoneditor": "^3.13.0",
        "vue": "^3.5.44",
        "vue-draggable-plus": "^0.6.1",
        "vue-router": "^5.4.0",
        "vuetify": "^4.3.2",
        "vuetify-nuxt-module": "^1.0.0-rc.6"
    },
    "devDependencies": {
        "@types/lodash": "^4.17.27",
        "@types/node": "^26.6.6",
        "sass-embedded": "^1.107.1",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "anyhow": "^4.0.0",
        "setmeup": "^2.0.0"
    },
    "overrides": {
        "@googlemaps/google-maps-services-js": {
            "query-string": "10.0.0"
        },
        "rimraf": "6.1.4"
    },
    "prettier": {
        "trailingComma": "none",
        "tabWidth": 4,
        "semi": false,
        "singleQuote": false,
        "arrowParens": "always",
        "bracketSpacing": false,
        "printWidth": 250
    },
    "type": "module"
}
